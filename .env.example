# ---------------------------------------------------------------------------
# Copie para .env.local (desenvolvimento) e cole as MESMAS variáveis nas
# Environment Variables do projeto na Vercel (produção).
#
# Atalho: `npm run vapid` gera sozinho VAPID_*, AUTH_SECRET e CRON_SECRET.
# ---------------------------------------------------------------------------

# ------------------------------ OBRIGATÓRIAS -------------------------------

# Postgres. Neon, Supabase, Vercel Postgres — qualquer um serve.
# Use a URL COM POOL; serverless abre conexão demais sem ele.
#   Neon     -> a que tem `-pooler` no host
#   Supabase -> "Transaction pooler", porta 6543, + ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Só para migração (npm run db:push). O pooler de transação derruba o DDL no
# meio, então aqui vai a conexão direta/de sessão.
#   Neon     -> pode deixar vazio (usa a DATABASE_URL)
#   Supabase -> "Session pooler", porta 5432
DIRECT_URL=""

# Assina o cookie de sessão. String aleatória de 32+ caracteres.
# Trocar isso desloga todo mundo.
AUTH_SECRET=""

# Identidade do servidor no Web Push (gere com `npm run vapid`).
# Trocar as chaves obriga todo mundo a reativar as notificações.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"

# Protege /api/cron/tick e /api/saude.
# A Vercel manda como `Authorization: Bearer <valor>`;
# cron externo usa `?chave=<valor>`.
CRON_SECRET=""

# --------------------------- CHAT (tudo opcional) ---------------------------
#
# SEM NENHUMA CHAVE AQUI O CHAT JÁ FUNCIONA, de graça e para sempre: o motor
# local monta as respostas com os seus números reais, sem chamar API nenhuma.
#
# As chaves abaixo só deixam a conversa mais natural. Se o provedor cair ou
# bater o limite diário, o motor local assume sozinho — nada quebra.
#
# Ordem de preferência quando há mais de uma: Groq, Gemini, OpenRouter,
# Anthropic. Use IA_PROVEDOR para forçar uma.

# Groq — grátis, sem cartão, e MUITO rápido. https://console.groq.com/keys
GROQ_API_KEY=""

# Google Gemini — grátis, sem cartão. https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# OpenRouter — modelos com sufixo :free. https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Anthropic — PAGA, sem nível gratuito. Só use se quiser mesmo.
ANTHROPIC_API_KEY=""

# Forçar um provedor: local | groq | gemini | openrouter | anthropic
IA_PROVEDOR=""

# Trocar o modelo do provedor escolhido. Padrões:
#   groq       -> llama-3.3-70b-versatile
#   gemini     -> gemini-2.0-flash
#   openrouter -> meta-llama/llama-3.3-70b-instruct:free
#   anthropic  -> claude-opus-5
IA_MODELO=""

# URL pública do app (só o OpenRouter usa, para atribuição).
APP_URL=""
