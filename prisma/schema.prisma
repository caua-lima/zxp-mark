generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime: use o pooler (Supabase 6543 / Neon -pooler).
  url       = env("DATABASE_URL")
  // Migracoes: precisa de conexao direta — pgbouncer em modo transacao nao
  // aguenta o DDL do db push. O script scripts/prisma-com-env.mjs cai de
  // volta na DATABASE_URL quando esta nao esta definida.
  directUrl = env("DIRECT_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  nome              String
  senhaHash         String
  timezone          String   @default("America/Sao_Paulo")

  /// Admin gerencia os acessos de todo mundo na aba Acesso.
  admin             Boolean  @default(false)
  /// Marcado quando o acesso e criado por um admin: pede troca no 1o login.
  trocarSenha       Boolean  @default(false)
  ultimoAcesso      DateTime?

  // Preferencias de notificacao
  notifMarcos       Boolean  @default(true)
  notifResumoDiario Boolean  @default(true)
  notifNoite        Boolean  @default(true)
  /// Empurrao do meio do dia: "mantenha o foco", com os numeros reais.
  notifFoco         Boolean  @default(true)
  horaResumo        Int      @default(8)   // 0-23, hora local
  horaFoco          Int      @default(12)  // 0-23, hora local
  horaNoite         Int      @default(21)  // 0-23, hora local

  /// O assistente só lê registros de saúde (medicamento, sono, episódios de hábito)
  /// se a pessoa ligar isto. Nasce DESLIGADO: privacidade por padrão.
  assistenteUsaSaude Boolean @default(false)

  criadoEm          DateTime @default(now())

  marcos        Marco[]
  contagens     Contagem[]
  inscricoes    Inscricao[]
  mensagens     Mensagem[]
  enviadas      Enviada[]
  acompanhamentos  Acompanhamento[]
  conquistasVistas ConquistaVista[]
  percepcoes       Percepcao[]
  sonos            Sono[]
  habitos          HabitoAcompanhado[]
  tratamentos      Tratamento[]
  humores          RegistroHumor[]

  @@index([email])
}

/// Um habito que a pessoa quer largar/manter. O cronometro corre desde `cicloInicio`.
model Marco {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  titulo        String
  preset        String   @default("personalizado") // chave em src/lib/habitos.ts
  emoji         String   @default("🔥")
  porque        String?  @db.Text                  // motivacao pessoal, entra no prompt do chat

  inicio        DateTime                            // primeira vez que comecou
  cicloInicio   DateTime                            // reinicia a cada recaida
  melhorMs      BigInt   @default(0)                // maior sequencia ja alcancada, em ms

  // Economia / impacto
  unidadesPorDia Float?                             // ex.: 20 cigarros/dia
  gastoDiario    Float?                             // ex.: 15.00 (R$/dia)

  ativo         Boolean  @default(true)
  arquivadoEm   DateTime?
  criadoEm      DateTime @default(now())

  recaidas      Recaida[]

  @@index([userId, ativo])
}

model Recaida {
  id        String   @id @default(cuid())
  marcoId   String
  marco     Marco    @relation(fields: [marcoId], references: [id], onDelete: Cascade)
  quando    DateTime @default(now())
  duracaoMs BigInt   @default(0)  // quanto durou a sequencia que caiu
  nota      String?  @db.Text
  gatilho   String?

  @@index([marcoId])
}

/// Contagem regressiva para uma data futura.
model Contagem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  titulo    String
  emoji     String   @default("🎯")
  descricao String?  @db.Text
  alvo      DateTime
  criadoEm  DateTime @default(now())

  /// Aviso todo dia com quantos dias faltam. Quando ligado, substitui a
  /// lista de `avisos` — nao faz sentido mandar os dois no mesmo dia.
  avisoDiario Boolean @default(true)
  /// Hora local do aviso diario desta contagem (0-23).
  horaAviso   Int     @default(12)
  /// Dias de antecedencia, usados quando avisoDiario esta desligado.
  avisos    Int[]    @default([30, 14, 7, 3, 1, 0])
  notificar Boolean  @default(true)
  /// Arquivada some da lista principal, mas o historico fica e ela para de avisar.
  arquivadoEm DateTime?

  @@index([userId])
}

/// Contagem crescente: o tempo corrido desde uma data (inicio de um tratamento,
/// de uma rotina, de um projeto). NAO e habito de abstinencia — nao tem recaida,
/// e o tempo que passa nao prova nada alem do tempo que passou.
model Acompanhamento {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  titulo      String
  /// tratamento | rotina | projeto | pessoal  (validado em src/lib/acompanhamento.ts)
  categoria   String   @default("pessoal")
  emoji       String   @default("📍")
  /// Cor de destaque, sempre dentro dos tokens do app: magenta | marfim | sucesso
  tom         String   @default("magenta")
  descricao   String?  @db.Text
  inicio      DateTime
  arquivadoEm DateTime?
  criadoEm    DateTime @default(now())

  @@index([userId, arquivadoEm])
}

/// Etapa da trilha que a pessoa ja viu comemorar. E o que impede a mesma
/// celebracao de aparecer de novo ao recarregar a pagina.
///
/// A linha com chave "_base" marca "ja olhei este ciclo pela primeira vez": as
/// etapas que ja tinham sido atingidas ficam como vistas em silencio, para
/// corrigir uma data ou abrir um marco antigo nao disparar uma enxurrada.
model ConquistaVista {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// marco | acompanhamento | sono
  tipo    String
  refId   String
  chave   String
  /// cicloInicio do marco / inicio do acompanhamento (sono usa a epoca)
  ciclo   DateTime
  vistaEm DateTime @default(now())

  @@unique([userId, refId, chave, ciclo])
  @@index([userId])
}

/// "Como voce esta se sentindo?" — melhora PERCEBIDA, escrita pela propria
/// pessoa. Opcional, por etapa, e nunca vira obrigacao diaria.
model Percepcao {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo         String
  refId        String
  chave        String
  ciclo        DateTime
  /// 1 (dificil) a 5 (muito bem); opcional
  humor        Int?
  nota         String?  @db.Text
  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  @@unique([userId, refId, chave, ciclo])
  @@index([userId])
}

/// Um periodo de sono informado pela pessoa. Instantes reais (UTC); quem
/// interpreta "que dia foi essa noite" e o fuso do usuario, em src/lib/datas.ts.
/// Noite sem registro NAO e zero hora: simplesmente nao existe linha.
model Sono {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dormiuEm  DateTime
  acordouEm DateTime
  /// 1 a 5, percebida
  qualidade Int
  nota      String?  @db.Text
  criadoEm  DateTime @default(now())

  @@index([userId, dormiuEm])
}

model Inscricao {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  agente    String?  @db.Text
  criadaEm  DateTime @default(now())
  usadaEm   DateTime @default(now())

  @@index([userId])
}

model Mensagem {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  papel    String   // "user" | "assistant"
  conteudo String   @db.Text
  criadaEm DateTime @default(now())

  @@index([userId, criadaEm])
}

/// Registro de notificacao enviada — garante que nada e enviado duas vezes.
model Enviada {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      String   // "marco" | "contagem" | "resumo" | "noite"
  refId     String   // id do marco/contagem, ou userId para resumos
  chave     String   // "6h", "d-7", "2026-08-27"
  ciclo     DateTime // cicloInicio do marco (permite reenviar apos recaida)
  titulo    String
  corpo     String   @db.Text
  enviadaEm DateTime @default(now())

  @@unique([refId, chave, ciclo])
  @@index([userId, enviadaEm])
}

/// Um hábito que a pessoa acompanha por REGISTROS (roer unhas, caminhada...), não
/// por tempo corrido. O conteúdo vem do catálogo (src/lib/conhecimento); aqui
/// mora só o que é da pessoa. Uma linha por (usuário, tema).
model HabitoAcompanhado {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// id do tema no catálogo ("unhas", "caminhada"...)
  temaId      String
  /// Quando a pessoa começou a acompanhar. A contagem nunca vem de antes disto.
  inicio      DateTime
  /// Objetivo pessoal, escrito pela pessoa. Opcional.
  objetivo    String?  @db.Text
  /// Meta pessoal por semana (dias ou minutos, conforme o tema). Opcional.
  metaSemanal Float?
  arquivadoEm DateTime?
  criadoEm    DateTime @default(now())

  eventos     EventoHabito[]

  @@unique([userId, temaId])
  @@index([userId])
}

/// Um registro de hábito. tipo: episodio | vontade | dia_sem | pratica.
/// "dia_sem" é a confirmação "hoje não roí": falta de registro NÃO equivale a ela.
model EventoHabito {
  id         String   @id @default(cuid())
  habitoId   String
  habito     HabitoAcompanhado @relation(fields: [habitoId], references: [id], onDelete: Cascade)
  /// redundante de propósito: toda consulta filtra por dono sem precisar de join
  userId     String

  tipo       String
  quando     DateTime
  /// dia local "YYYY-MM-DD" no fuso do usuário NO MOMENTO do registro
  dia        String
  /// 1 a 5, percebida
  intensidade Int?
  /// trabalho | estudo | tedio | tensao | outro
  contexto   String?
  estrategia String?
  /// 1 a 5, percebido
  desconforto Int?
  aparencia  Int?
  /// minutos, vezes ou doses, conforme o tema (só tipo "pratica")
  valor      Float?
  nota       String?  @db.Text
  criadoEm   DateTime @default(now())

  @@index([habitoId, dia])
  @@index([userId])
}

/// Acompanhamento de um medicamento. É sobre REGISTRO: não prescreve, não calcula
/// eficácia e não decide dose. O dia de início do tratamento e o da dose atual são
/// coisas diferentes e moram em lugares diferentes.
model Tratamento {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// id do tema no catálogo ("escitalopram") ou "outro"
  medicamentoId String
  /// como a pessoa informou, já confirmado
  nome          String
  /// início do TRATAMENTO (não da dose atual)
  inicio        DateTime
  /// horário previsto, "HH:mm", conforme a prescrição que a pessoa informou
  horario       String?
  /// lembrete é opt-in; o texto padrão não cita medicamento nem dose
  lembrete          Boolean @default(false)
  lembreteDetalhado Boolean @default(false)
  arquivadoEm   DateTime?
  criadoEm      DateTime @default(now())

  doses         DoseTratamento[]
  tomadas       TomadaDia[]
  efeitos       EfeitoRegistrado[]

  @@index([userId])
}

/// Histórico de doses INFORMADAS. Mudar de dose acrescenta uma linha; nada é apagado
/// e nada recomeça. A dose vigente é a de maior "desde" que já começou.
model DoseTratamento {
  id            String   @id @default(cuid())
  tratamentoId  String
  tratamento    Tratamento @relation(fields: [tratamentoId], references: [id], onDelete: Cascade)
  userId        String

  /// texto livre como a pessoa informou ("20 mg")
  descricao     String
  mg            Float?
  /// início DESTA dose
  desde         DateTime
  nota          String?  @db.Text
  criadoEm      DateTime @default(now())

  @@index([tratamentoId, desde])
  @@index([userId])
}

/// Um dia com informação sobre a tomada. Dia SEM linha = sem informação (não é "não
/// tomou"). Único por (tratamento, dia): editar e registrar de novo não duplica.
model TomadaDia {
  id            String   @id @default(cuid())
  tratamentoId  String
  tratamento    Tratamento @relation(fields: [tratamentoId], references: [id], onDelete: Cascade)
  userId        String

  /// dia local "YYYY-MM-DD"
  dia           String
  /// tomou | nao_tomou
  estado        String
  /// horário em que tomou, "HH:mm", opcional
  horario       String?
  nota          String?  @db.Text
  criadoEm      DateTime @default(now())
  atualizadaEm  DateTime @updatedAt

  @@unique([tratamentoId, dia])
  @@index([userId])
}

/// Efeito indesejado relatado pela pessoa. É dado dela: o app não o interpreta.
model EfeitoRegistrado {
  id            String   @id @default(cuid())
  tratamentoId  String
  tratamento    Tratamento @relation(fields: [tratamentoId], references: [id], onDelete: Cascade)
  userId        String

  quando        DateTime
  dia           String
  descricao     String   @db.Text
  /// 1 leve, 2 moderado, 3 forte
  intensidade   Int?
  nota          String?  @db.Text
  criadoEm      DateTime @default(now())

  @@index([tratamentoId, dia])
  @@index([userId])
}

/// "Como estou": um registro por dia, editável. Dado da pessoa; o app mostra lado a lado
/// com sono e hábitos, mas NUNCA afirma que um causou o outro.
model RegistroHumor {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// dia local "YYYY-MM-DD"
  dia          String
  /// 1 (difícil) a 5 (muito bem)
  humor        Int
  energia      Int?
  ansiedade    Int?
  nota         String?  @db.Text
  criadoEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  @@unique([userId, dia])
  @@index([userId])
}
